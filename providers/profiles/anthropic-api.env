# troupely provider profile — Anthropic first-party API (the default, simplest path)
# Native: Claude Code speaks the Anthropic API directly. No gateway, no proxy.
# Apply with:  ./providers/troupely-provider use anthropic-api
#
# Get a key at https://console.anthropic.com → fill it in, then `use` this profile.

ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"

# Leave these empty for the first-party API (a gateway profile sets them instead).
ANTHROPIC_AUTH_TOKEN=""
ANTHROPIC_BASE_URL=""

# Optional model pinning — aliases (opus/sonnet/haiku/fable) already resolve to the
# current recommended versions on the first-party API, so you usually leave these unset.
# ANTHROPIC_MODEL="claude-opus-4-8"
# ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5"   # also the background/small-task model
