# troupely provider profile — Google Vertex AI (native-Anthropic tier)
# Claude Code talks to Vertex directly via Application Default Credentials. No proxy.
# Apply with:  ./providers/troupely-provider use vertex
#
# Prereqs: ADC available (gcloud auth application-default login, or a mounted service-
# account JSON via GOOGLE_APPLICATION_CREDENTIALS) AND Claude models enabled in your
# GCP project + region.

CLAUDE_CODE_USE_VERTEX="1"
CLOUD_ML_REGION="us-east5"
ANTHROPIC_VERTEX_PROJECT_ID="your-gcp-project-id"

# Service-account key path (mount it into the container) — or rely on ADC and leave blank.
# GOOGLE_APPLICATION_CREDENTIALS="/vault/.gcp/sa.json"

# Vertex aliases lag the first-party catalog — PIN explicit version names.
ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-4-8"
ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-4-6"
ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5"   # background/small-task model

# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"
