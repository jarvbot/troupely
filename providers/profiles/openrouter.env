# troupely provider profile — OpenRouter "Anthropic skin" (native-Anthropic tier)
# OpenRouter exposes an Anthropic-Messages-compatible endpoint, so Claude Code talks
# to it natively — no LiteLLM proxy needed. Routes to Claude models via your OpenRouter key.
# Apply with:  ./providers/troupely-provider use openrouter
#
# Get a key at https://openrouter.ai/keys.

# Gateway auth goes in AUTH_TOKEN (sent as the Authorization: Bearer header), NOT API_KEY.
ANTHROPIC_AUTH_TOKEN="sk-or-REPLACE_ME"
ANTHROPIC_BASE_URL="https://openrouter.ai/api"

# ⚠️ THE GOTCHA: set ANTHROPIC_API_KEY to EMPTY (not unset). If a real key is present
# alongside ANTHROPIC_AUTH_TOKEN, both an x-api-key and a Bearer header get sent and the
# gateway rejects the request. Empty-string keeps the slot occupied so nothing else fills it.
ANTHROPIC_API_KEY=""

# OpenRouter needs explicit, fully-qualified model IDs (its catalog is namespaced).
ANTHROPIC_MODEL="anthropic/claude-opus-4-8"
ANTHROPIC_DEFAULT_HAIKU_MODEL="anthropic/claude-haiku-4-5"   # background/small-task model
