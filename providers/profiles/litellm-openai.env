# troupely provider profile — OpenAI-compatible models via a LiteLLM proxy (OpenAI-proxy tier)
# This is the "run troupely on GPT / Gemini / a local model" path. Claude Code only
# speaks the Anthropic Messages API; LiteLLM's unified endpoint accepts that shape and
# translates it to whatever backend model you configure (OpenAI, Gemini, Ollama, …).
# Apply with:  ./providers/troupely-provider use litellm-openai
#
# Stand up the proxy first — see providers/litellm/README.md (config + compose included).

# Point at LiteLLM's UNIFIED endpoint (its native Anthropic-format route). Recommended
# over the /anthropic pass-through: you get load-balancing, fallbacks, and cost tracking.
ANTHROPIC_BASE_URL="http://litellm:4000"

# The LiteLLM master/virtual key, sent as the Authorization: Bearer header.
ANTHROPIC_AUTH_TOKEN="sk-litellm-REPLACE_ME"

# ⚠️ Same gotcha as any gateway: empty (not unset) so no stray x-api-key header is sent.
ANTHROPIC_API_KEY=""

# Model IDs here are the model_name aliases YOU define in litellm config.yaml — they do
# NOT have to be Claude names. e.g. map "gpt-5" / "gemini-2.5-pro" / "llama-local" there,
# then reference those aliases. The names below match providers/litellm/config.example.yaml.
ANTHROPIC_MODEL="gpt-main"
ANTHROPIC_DEFAULT_HAIKU_MODEL="gpt-small"   # background/small-task model

# NOTE: behind a non-Claude model, Claude-specific features (adaptive thinking, effort,
# prompt caching) degrade to whatever the backend supports. Functionality > fidelity.
