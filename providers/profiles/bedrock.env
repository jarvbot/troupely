# troupely provider profile — Amazon Bedrock (native-Anthropic tier)
# Claude Code talks to Bedrock directly via the AWS SDK credential chain. No proxy.
# Apply with:  ./providers/troupely-provider use bedrock
#
# Prereqs: the container/host has AWS creds (env vars below, an ~/.aws profile, or an
# instance role) AND the Claude models are enabled in your Bedrock account + region.

CLAUDE_CODE_USE_BEDROCK="1"
AWS_REGION="us-east-1"

# Credentials — set here, OR rely on a mounted ~/.aws / instance role and leave blank.
AWS_ACCESS_KEY_ID="REPLACE_ME"
AWS_SECRET_ACCESS_KEY="REPLACE_ME"
# AWS_SESSION_TOKEN="REPLACE_ME"   # only for temporary STS creds

# Bedrock aliases lag the first-party catalog — PIN explicit inference-profile IDs.
ANTHROPIC_DEFAULT_OPUS_MODEL="us.anthropic.claude-opus-4-8"
ANTHROPIC_DEFAULT_SONNET_MODEL="us.anthropic.claude-sonnet-4-6"
ANTHROPIC_DEFAULT_HAIKU_MODEL="us.anthropic.claude-haiku-4-5"   # background/small-task model

# Bedrock has no first-party-only experimental betas; quiet the negotiation if needed.
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"
