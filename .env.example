# troupely — copy to .env and fill, OR just run ./setup.sh (recommended).
# Placeholders are intentionally fake.

# ── Host UID/GID — match your user so the bind-mounted vault has correct perms ──
# macOS: 501/20 · Linux: usually 1000/1000.  (setup.sh autodetects these.)
HOST_UID=501
HOST_GID=20

# ── Personas — comma-separated; each needs a dir at vault/personas/<name>/ ──
# (copy an archetype from personas/ into vault/personas/<name>/, or use setup.sh)
TROUPELY_PERSONAS=orchestrator

# ── Heartbeat — every persona starts with /loop <interval> running its CLAUDE.md Heartbeat ──
# 30m default · 15m, 2h, … · off = none. Applies at the next ./troupely.sh restart <name>.
# TROUPELY_HEARTBEAT=30m

# ── Telegram — ONE bot token per persona: TROUPELY_TG_TOKEN_<PERSONA-UPPERCASED> ──
# Mint via @BotFather or the mint-bot adapter. e.g. for personas "orchestrator,researcher":
TROUPELY_TG_TOKEN_ORCHESTRATOR=123456789:REPLACE_ME
# TROUPELY_TG_TOKEN_RESEARCHER=123456789:REPLACE_ME

# ── Model auth — pick ONE option (A is the no-API-key path) ─────────────────
# A) Claude Pro/Max SUBSCRIPTION (no key): leave all three blank, then after `up`:
#       docker exec -it troupely claude auth login --claudeai
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
#
# B) Anthropic API key:  ANTHROPIC_API_KEY="sk-ant-..."         (other two blank)
# C) OpenRouter:         ANTHROPIC_AUTH_TOKEN="sk-or-..."   ANTHROPIC_BASE_URL="https://openrouter.ai/api"      ANTHROPIC_API_KEY=""
# D) Kimi (Moonshot):    ANTHROPIC_AUTH_TOKEN="<key>"       ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"  ANTHROPIC_API_KEY=""
# E) DeepSeek:           ANTHROPIC_AUTH_TOKEN="<key>"       ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic" ANTHROPIC_API_KEY=""  ANTHROPIC_MODEL="deepseek-chat"
#   For B–E, set ANTHROPIC_API_KEY to an EMPTY STRING (not unset) when a base-url is set.
#   Bedrock / Vertex / LiteLLM and model overrides: see providers/.
